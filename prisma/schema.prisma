// ============================================================
// INVENTORY MANAGEMENT SYSTEM — Prisma schema
// Target DB: Azure SQL / SQL Server (provider = sqlserver)
// Notes:
//  - SQL Server has no native enums; status/type fields are String
//    with allowed values centralized in lib/constants.ts + zod.
//  - createdBy/updatedBy are plain audit columns (no FK relation) to
//    avoid an explosion of back-relations on User. Meaningful "actor"
//    relations (submitter, requester, audit user) are modeled explicitly.
//  - SQL Server disallows multiple cascade paths, so FK relations use
//    onDelete/onUpdate: NoAction (PKs are immutable; master data is
//    deactivated via status flags, not hard-deleted). The only cascades
//    are parent submission -> its detail/allocation children.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================
// USER & ACCESS MANAGEMENT
// ============================================================

model Role {
  id          Int     @id @default(autoincrement())
  roleName    String  @unique // SuperAdmin, InternalAdmin, Editor, GrowerUser, VendorUser
  description String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id              Int     @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String  @unique
  passwordHash    String?
  entraObjectId   String? // Entra oid (SSO), backfilled on first login. Uniqueness is a FILTERED unique index (migration 20260723090000), NOT @unique — a plain SQL Server UNIQUE treats all NULLs as equal (only one allowed) and breaks multi-user seeding.
  roleId          Int
  growerId        Int? // populated for grower users
  vendorId        Int? // populated for vendor users
  isActive        Boolean @default(true)
  preferredLocale String  @default("en") // personal UI + email language: en, es

  // Power BI embedding (lib/powerbi) — set only for users who signed in via Entra.
  // The MSAL token cache holds a REFRESH token, so it is encrypted with
  // TOKEN_CACHE_SECRET before it is written here (lib/auth/token-cache.ts) and is
  // useless on its own in a database backup. entraHomeAccountId is MSAL's handle
  // for the account inside that cache. Both are cleared when the cache stops
  // working, so a stale entry re-authenticates rather than failing forever.
  entraHomeAccountId String?
  entraTokenCache    String? @db.NVarChar(Max)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  role                Role                 @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grower              Grower?              @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor              Vendor?              @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submissions         GrowerSubmission[]   @relation("SubmissionSubmittedBy")
  vendorSubmissions   VendorSubmission[]   @relation("VendorSubmissionSubmittedBy")
  missingItemRequests MissingItemRequest[] @relation("RequestRequestedBy")
  auditLogs           AuditLog[]           @relation("AuditUser")
  magicTokens         MagicToken[]

  @@index([roleId])
  @@index([growerId])
  @@index([vendorId])
}

/// Passwordless sign-in links for EXTERNAL users (growers & vendors); internal
/// staff use Entra. One row per issued link. Only the SHA-256 of the JWT's nonce
/// is stored, so a database leak yields nothing usable — see lib/auth/magic-link.ts.
model MagicToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique // SHA-256 of the nonce; never the raw token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
}

// ============================================================
// MASTER DATA (ENTITIES)
// ============================================================

model Grower {
  id              Int     @id @default(autoincrement())
  growerName      String
  primaryEmail    String?
  status          String  @default("Active") // Active, Inactive, Pending
  preferredLocale String  @default("en") // language for emails sent to primaryEmail: en, es

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  users               User[]
  locations           GrowerLocation[]
  authorizations      GrowerItemAuthorization[]
  submissions         GrowerSubmission[]
  ledgerEntries       InventoryLedger[]
  allocations         VendorAllocation[]
  orders              Order[]
  missingItemRequests MissingItemRequest[]
  lowInventoryFlags   LowInventoryFlag[]
  thresholds          ItemThreshold[]
  schedulerSettings   SchedulerSetting[]
  notifications       NotificationLog[]
  itemMessageTargets  ItemMessageGrower[]
}

model Vendor {
  id               Int     @id @default(autoincrement())
  vendorName       String
  vendorType       String? // Manufacturer, Pallet Pooling, 3PL
  // Sites are a many-to-many (VendorLocation) — see that model. A vendor's
  // REGION is read through those rather than stored: a region is a property of
  // a place, and duplicating it here let the two disagree.
  //
  // Where the vendor is headquartered. Deliberately NOT inherited from the
  // locations: a vendor can be based in one country and ship from facilities in
  // others. Distinct again from `supplyCountries`, which is where they ship TO.
  countryId        Int?
  primaryContact   String?
  contactEmail     String?
  contactPhone     String?
  leadTimeDays     Int? // whole days from order to delivery
  paymentTermsDays Int? // "Net N days" — N only; non-numeric terms are not modelled
  ptAccountNumber  String?
  notes            String?
  status           String  @default("Active") // Active, Inactive
  preferredLocale  String  @default("en") // language for emails sent to contactEmail: en, es

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  homeCountry        Country?                 @relation("VendorHomeCountry", fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations          VendorLocation[]
  users              User[]
  itemVendors        ItemVendor[]
  materialCategories VendorMaterialCategory[]
  supplyCountries    VendorCountry[]
  submissions        VendorSubmission[]
  orders             Order[]
  notifications      NotificationLog[]

  @@index([countryId])
}

model Location {
  id             Int     @id @default(autoincrement())
  locationName   String
  locationType   String? // Packing House, Warehouse, Cross-dock, Grower
  regionId       Int?
  countryId      Int?
  commodityFocus String?
  keyPersonnel   String?
  notes          String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  region            Region?                  @relation(fields: [regionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  country           Country?                 @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  growers           GrowerLocation[]
  vendors           VendorLocation[]
  submissions       GrowerSubmission[]
  submissionDetails GrowerSubmissionDetail[]
  ledgerEntries     InventoryLedger[]

  @@index([regionId])
  @@index([countryId])
}

// ============================================================
// CATEGORY & ITEM MANAGEMENT
// ============================================================

model Commodity {
  code String @id // e.g., AP (Asparagus), BP (Bell Peppers)
  name String

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  items Item[]
}

// A category is also the UNIT: `name` labels every quantity recorded for its
// items ("350 Boxes"), the thresholds they are compared against, and level 0 of
// their packaging chains. Renaming one relabels history — it does not convert it.
model MaterialCategory {
  code String @id // e.g., BX (Boxes), BG (Bags)
  name String

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  subCategories   SubCategory[]
  items           Item[]
  vendors         VendorMaterialCategory[]
  packagingChains PackagingChain[]
}

model SubCategory {
  id                   Int    @id @default(autoincrement())
  materialCategoryCode String
  name                 String // Cardboard Boxes, PLU Stickers

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  materialCategory MaterialCategory @relation(fields: [materialCategoryCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  items            Item[]

  @@index([materialCategoryCode])
}

model Item {
  id                   String  @id // CC-MM-NNNNN, auto-generated on create (lib/actions/items.ts)
  legacyFamousId       String? // Famous ID from the initial data upload only; not editable in the UI
  itemName             String
  commodityCode        String?
  materialCategoryCode String?
  subCategoryId        Int?
  countryOfOriginId    Int?
  // NOTE: there is no unit of measure. A quantity is counted in the item's
  // MATERIAL CATEGORY — an item in "Boxes" is counted in boxes — so every count,
  // order and threshold is in the same terms by construction. A separate
  // per-item unit could only ever disagree with it.
  applicationMethod    String? // Machine, Hand, Machine/Hand, N/A
  status               String  @default("Active") // Active, Inactive, Review
  notes                String?
  // Storage KEY of the item's photo (lib/storage), e.g.
  // "items/AP-BX-00001/9f3c….webp" — deliberately not a URL, so the storage
  // account or container can change without rewriting this column. The uuid in
  // the key changes on every replace, which is what makes the served image
  // safely immutable-cacheable. Null = no photo. One per item.
  imageKey             String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  commodity               Commodity?                @relation(fields: [commodityCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  materialCategory        MaterialCategory?         @relation(fields: [materialCategoryCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  subCategory             SubCategory?              @relation(fields: [subCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  countryOfOrigin         Country?                  @relation(fields: [countryOfOriginId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorizations          GrowerItemAuthorization[]
  submissionDetails       GrowerSubmissionDetail[]
  ledgerEntries           InventoryLedger[]
  itemVendors             ItemVendor[]
  orders                  Order[]
  vendorSubmissionDetails VendorSubmissionDetail[]
  lowInventoryFlags       LowInventoryFlag[]
  thresholds              ItemThreshold[]
  messages                ItemMessage[]

  @@index([commodityCode])
  @@index([materialCategoryCode])
  @@index([subCategoryId])
  @@index([countryOfOriginId])
}

// Shared country lookup, managed at /admin/countries. Was `CountryOfOrigin`,
// serving only the item dropdown; now also backs a location's country, a
// vendor's home country and the countries a vendor can supply to.
//
// `isSelectable` exists for the "N/A" row: a perfectly good answer for an item's
// origin, but meaningless in a supply-to or location picker. Those pickers
// filter on it; the item dropdown does not.
model Country {
  id           Int     @id @default(autoincrement())
  name         String  @unique // USA, Mexico, Canada, Peru, Ecuador, N/A
  isSelectable Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  items         Item[]
  locations     Location[]
  homeToVendors Vendor[]        @relation("VendorHomeCountry")
  suppliedBy    VendorCountry[]
}

// Which countries a vendor can supply to. Many-to-many, soft-toggled via
// isActive to mirror ItemVendor / VendorMaterialCategory.
model VendorCountry {
  id        Int     @id @default(autoincrement())
  vendorId  Int
  countryId Int
  isActive  Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  country Country @relation(fields: [countryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vendorId, countryId])
  @@index([countryId])
}

// Region lookup, now used by Location alone. Items dropped it (country of
// origin is the only geography they need) and vendors read it through their
// location. Seeded from the values that used to live in the free-text `region`
// columns. Deliberately has no admin page — values are managed in the seed / by
// migration.
model Region {
  id   Int    @id @default(autoincrement())
  name String @unique // West, Central, East

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  locations Location[]
}

// ============================================================
// MAPPING TABLES
// ============================================================

// Which locations a grower counts inventory at. Many-to-many: per-location
// inventory only means anything when a grower has more than one site, and the
// submit page's location picker is driven straight off this list.
model GrowerLocation {
  id         Int     @id @default(autoincrement())
  growerId   Int
  locationId Int
  isActive   Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  grower   Grower   @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location Location @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([growerId, locationId])
  @@index([locationId])
}

// Which sites a vendor operates from. Many-to-many, mirroring GrowerLocation:
// a vendor can manufacture in one place and ship from another, and their region
// is read through these rather than stored on the vendor.
//
// Unlike the grower side this drives no submission scoping — a vendor's report
// is still one per vendor per day, not per site. These sites are master data:
// the admin list, the region filter and the export read them.
model VendorLocation {
  id         Int     @id @default(autoincrement())
  vendorId   Int
  locationId Int
  isActive   Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location Location @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vendorId, locationId])
  @@index([locationId])
}

model GrowerItemAuthorization {
  id       Int     @id @default(autoincrement())
  growerId Int
  itemId   String
  isActive Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  grower Grower @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([growerId, itemId])
  @@index([itemId])
}

// Also carries this vendor's packaging setup for the item: which PackagingChain
// they use and the per-level ratios (VendorPackRatio). See the PACKAGING section
// below — it is descriptive and never changes an ordered quantity.
model ItemVendor {
  id       Int     @id @default(autoincrement())
  vendorId Int
  itemId   String
  isActive Boolean @default(true)

  packagingChainId Int?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  vendor         Vendor            @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item           Item              @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packagingChain PackagingChain?   @relation(fields: [packagingChainId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packRatios     VendorPackRatio[]

  @@unique([vendorId, itemId])
  @@index([itemId])
  @@index([packagingChainId])
}

// Which material categories a vendor supplies. Many-to-many mapping, soft-
// toggled via isActive to mirror ItemVendor (kept for history).
model VendorMaterialCategory {
  id                   Int     @id @default(autoincrement())
  vendorId             Int
  materialCategoryCode String
  isActive             Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  materialCategory MaterialCategory @relation(fields: [materialCategoryCode], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vendorId, materialCategoryCode])
  @@index([materialCategoryCode])
}

// ============================================================
// GROWER INVENTORY SUBMISSION & WORKFLOW
// ============================================================

// One submission per grower, per LOCATION, per day.
//
// The location lives here rather than only on the details because `status`,
// `submittedBy` and `comments` are per-location facts. With one row per
// grower-day there would be no way to express "Yuma submitted, Salinas still a
// draft", and the ledger rebuild in submitInventory — which deletes and
// recreates every row for the submission — would promote another location's
// draft numbers the moment any one location was submitted. Scoping the
// submission to a location makes that rebuild correct by construction.
model GrowerSubmission {
  id             Int       @id @default(autoincrement())
  growerId       Int
  locationId     Int
  submittedBy    Int
  submissionDate DateTime  @default(now())
  status         String    @default("Approved") // Pending, Approved, Rejected (direct-submit => Approved)
  reviewedBy     Int?
  reviewedAt     DateTime?
  comments       String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  grower    Grower                   @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location  Location                 @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submitter User                     @relation("SubmissionSubmittedBy", fields: [submittedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  details   GrowerSubmissionDetail[]
  ledger    InventoryLedger[]

  @@index([growerId])
  @@index([submissionDate])
  @@index([growerId, locationId, submissionDate])
}

model GrowerSubmissionDetail {
  id             Int     @id @default(autoincrement())
  submissionId   Int
  itemId         String
  // Denormalised from the parent submission, which now carries the location.
  // Kept because the ledger copies it and both latestPerItem (lib/grower/data.ts)
  // and the admin low-inventory query read it directly rather than joining up.
  locationId     Int
  quantityOnHand Decimal @default(0)
  isLowFlagged   Boolean @default(false)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  submission GrowerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item       Item             @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location   Location         @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // The submission is already scoped to one location, so item is unique within
  // it. This was previously enforced only by a findFirst in submitInventory.
  @@unique([submissionId, itemId])
  @@index([submissionId])
  @@index([itemId])
  @@index([locationId])
}

// Grower purchase orders. Raised per item against one of the item's mapped
// vendors, independently of the daily on-hand count. Multiple open orders per
// item (and per vendor) are allowed. When an order is Received or Cancelled its
// closedAt is stamped; the grower's active views show Open orders plus anything
// closed today, so a same-day receipt stays visible but drops off the next day.
model Order {
  id                   Int       @id @default(autoincrement())
  growerId             Int
  itemId               String
  vendorId             Int
  quantity             Decimal   @default(0)
  status               String    @default("Open") // Open, Received, Cancelled
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime? // grower-editable expected arrival date
  closedAt             DateTime? // set when Received or Cancelled
  notes                String?

  // Receipt validation: did we get what we ordered? Exists to score vendors —
  // deliberately does NOT touch inventory. On-hand stock comes from the grower's
  // daily count, never from a receipt.
  //
  // There is no `expectedQuantity`. Packaging is descriptive, so what is ordered
  // is what arrives; a column that always equalled `quantity` was dead weight.
  receivedQuantity Decimal? // what the grower confirmed on receipt
  receiptNote      String? // Short, Damaged, Over — only captured on a mismatch

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  grower    Grower          @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item      Item            @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packLines OrderPackLine[]

  @@index([growerId, status])
  @@index([itemId])
  @@index([vendorId])
}

// ============================================================
// ANALYTICS & LEDGER (Power BI friendly FACT table)
// ============================================================

model InventoryLedger {
  id              Int      @id @default(autoincrement())
  submissionId    Int?
  date            DateTime
  growerId        Int
  itemId          String
  locationId      Int
  transactionType String   @default("Daily Count Update") // Daily Count Update, Manual Adjustment
  finalQuantity   Decimal

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  submission GrowerSubmission? @relation(fields: [submissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grower     Grower            @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item       Item              @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  location   Location          @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([growerId, itemId, locationId, date])
  @@index([date])
}

// ============================================================
// VENDOR INVENTORY SUBMISSION
// ============================================================

model VendorSubmission {
  id             Int      @id @default(autoincrement())
  vendorId       Int
  submittedBy    Int
  submissionDate DateTime @default(now())
  status         String   @default("Approved")
  comments       String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  vendor    Vendor                   @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submitter User                     @relation("VendorSubmissionSubmittedBy", fields: [submittedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  details   VendorSubmissionDetail[]

  @@index([vendorId])
  @@index([submissionDate])
}

model VendorSubmissionDetail {
  id            Int     @id @default(autoincrement())
  submissionId  Int
  itemId        String
  quantity      Decimal @default(0)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  submission  VendorSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item        Item               @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allocations VendorAllocation[]

  @@index([submissionId])
  @@index([itemId])
}

// Per-grower breakdown of a vendor's item quantity
model VendorAllocation {
  id                       Int     @id @default(autoincrement())
  vendorSubmissionDetailId Int
  growerId                 Int
  quantity                 Decimal @default(0)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  detail VendorSubmissionDetail @relation(fields: [vendorSubmissionDetailId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grower Grower                 @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vendorSubmissionDetailId])
  @@index([growerId])
}

// ============================================================
// GROWER REQUESTS & FLAGS
// ============================================================

model MissingItemRequest {
  id            Int       @id @default(autoincrement())
  growerId      Int
  requestedBy   Int
  itemName      String
  commodityHint String?
  categoryHint  String?
  notes         String?
  status        String    @default("Open") // Open, Reviewed, Fulfilled, Rejected
  reviewedBy    Int?
  reviewedAt    DateTime?
  reviewNotes   String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  grower    Grower @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requester User   @relation("RequestRequestedBy", fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([growerId])
  @@index([status])
}

model LowInventoryFlag {
  id           Int       @id @default(autoincrement())
  growerId     Int
  itemId       String
  flaggedBy    Int
  submissionId Int?
  reason       String?
  // isActive drives BOTH the grower's checkbox and the admin review queue:
  //   true                       => awaiting admin review (checkbox shown to grower)
  //   false, reviewedAt set      => cleared by an admin review
  //   false, reviewedAt null     => cleared by the grower (self-unflag)
  isActive     Boolean   @default(true)
  reviewedBy   Int?
  reviewedAt   DateTime?
  reviewNotes  String?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  grower Grower @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([growerId])
  @@index([itemId])
}

// ============================================================
// THRESHOLDS, SETTINGS, CONVERSIONS
// ============================================================

// growerId null => global default threshold for the item
model ItemThreshold {
  id                Int     @id @default(autoincrement())
  itemId            String
  growerId          Int?
  // No unit: the quantity is in the item's material category, the same terms the
  // counts it is compared against are recorded in.
  thresholdQuantity Decimal

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  item   Item    @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grower Grower? @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([itemId, growerId])
  @@index([itemId])
}

// scope = Global (growerId null) or per-grower override
// Reminder cadence for growers who haven't submitted. A Grower-scoped row
// replaces the Global one wholesale for that grower — there is no field-level
// merge, so a grower row must be complete on its own.
//
// `thresholdDays` is only read when `cadenceType` is "AfterNDays"; the other
// cadences imply their own tolerance (see cadenceDays in lib/scheduler/reminders.ts).
//
// There is deliberately no re-nag frequency. Once a grower is overdue they get
// at most one reminder per day, enforced by the NotificationLog check in
// runReminderCheck. A `reminderFrequency` column used to sit here and was never
// read by anything — the admin UI offered Daily/Weekly and both behaved daily.
model SchedulerSetting {
  id            Int     @id @default(autoincrement())
  scope         String  @default("Global") // Global, Grower
  growerId      Int?
  cadenceType   String  @default("AfterNDays") // Daily, Weekly, Monthly, AfterNDays
  thresholdDays Int     @default(3) // days of no submission before reminders start ("AfterNDays" only)
  isEnabled     Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  grower Grower? @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([growerId])
}

// ============================================================
// PACKAGING
// How a SKU is packed for shipping. Two halves, deliberately separate:
//
//   1. The CHAIN (PackagingChain + PackagingChainLevel) is structure only —
//      "Bags -> Boxes -> Cases" — and carries NO numbers. It hangs off a
//      material category, which is both what makes it pickable for an item and
//      what labels its innermost level, so the chain is defined once per
//      category instead of per item.
//   2. The RATIOS (VendorPackRatio) are per vendor, on the ItemVendor mapping.
//      Two vendors can use the same chain with different numbers: one packs 10
//      bags to a box, another 20.
//
// PACKAGING IS DESCRIPTIVE AND NEVER CHANGES A QUANTITY. Outer boxes, cases and
// pallets are discarded on receipt — they are not inventory and never were. All
// this works out is how many containers an ordered quantity occupies on the way.
// What a grower orders is what a grower receives.
// ============================================================

model PackagingChain {
  id                   Int     @id @default(autoincrement())
  // Also the chain's starting point: level 0 is labelled with this category's
  // name, and a chain is only offered for items in the same category.
  materialCategoryCode String
  name                 String // "Bags → Boxes → Cases"
  isActive             Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  materialCategory MaterialCategory      @relation(fields: [materialCategoryCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  levels           PackagingChainLevel[]
  itemVendors      ItemVendor[]

  @@index([materialCategoryCode])
}

model PackagingChainLevel {
  id       Int    @id @default(autoincrement())
  chainId  Int
  level    Int // 1 = first level above the item's own quantity, 2 = next, ...
  unitName String // "Boxes", "Cases"

  chain PackagingChain @relation(fields: [chainId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([chainId, level])
}

// How many of level-1 fit into one of `level`, for one vendor's mapping.
// e.g. level 1 perParent 10 => 10 Bags per Box.
model VendorPackRatio {
  id           Int @id @default(autoincrement())
  itemVendorId Int
  level        Int
  perParent    Int

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  itemVendor ItemVendor @relation(fields: [itemVendorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([itemVendorId, level])
}

// Immutable per-level snapshot of what an order occupies, written once at
// creation. Kept as rows (not JSON) so Power BI can aggregate it directly, and
// so later edits to a vendor's ratios — or a renamed category — never rewrite
// order history. Level 0 always equals the order's own `quantity`.
model OrderPackLine {
  id       Int     @id @default(autoincrement())
  orderId  Int
  level    Int // 0 = the ordered quantity itself, 1+ = packaging levels
  unitName String // level 0 carries the item's category name as at order time
  quantity Decimal

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, level])
}

// ============================================================
// AUDIT, NOTIFICATIONS, REPORTS
// ============================================================

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String // Create, Update, Delete, Export
  entityType String // Item, Grower, Vendor, User, ...
  entityId   String?
  changes    String? // JSON string of before/after
  createdAt  DateTime @default(now())

  user User @relation("AuditUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

/// The email OUTBOX, not just an audit trail.
///
/// With EMAIL_PROVIDER=acs, notify() only INSERTs here (status "Queued") and
/// returns; lib/email/dispatch.ts is what actually talks to ACS, at a rate the
/// provider's limits allow. That indirection is the whole reason the daily
/// reminder burst doesn't get 429'd into oblivion — see docs/email-delivery.md.
model NotificationLog {
  id      Int    @id @default(autoincrement())
  type    String // SubmissionReceived, MissingItemRequest, LowInventory, ScheduledReminder, MagicLink
  /// One or more recipients, comma-separated. Multiple only for the admin
  /// fan-out, which groups admins by language into one message per locale.
  toEmail String
  growerId      Int?
  vendorId      Int?
  subject       String
  body          String // plaintext (used by the Outbox list + as the email text part)
  bodyHtml      String?   @db.NVarChar(Max) // rendered React Email HTML (Outbox preview + email html part)
  status        String    @default("Mocked") // Mocked, Queued, Sending, Sent, Failed
  relatedEntity String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  // ---- queue bookkeeping (unused while EMAIL_PROVIDER=local) ----
  /// Lower goes first: 1 auth, 3 transactional, 7 bulk. A grower waiting on a
  /// sign-in link must not queue behind a hundred reminders.
  priority      Int       @default(5)
  attempts      Int       @default(0)
  /// Doubles as the rate-limit window (attempts inside the last minute/hour are
  /// what the provider counts) and the stale-lock clock for crashed dispatchers.
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  lastError     String?

  grower Grower? @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt])
  @@index([type])
  @@index([status, priority, createdAt]) // the dispatcher's claim query
  @@index([lastAttemptAt]) // rolling rate-limit window counts
}

model PowerBiReport {
  id        Int     @id @default(autoincrement())
  name      String
  embedUrl  String
  roleScope String  @default("Admin") // which roles can view
  isActive  Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt
}

// ============================================================
// GLOBAL ITEM MESSAGES
// Admin-authored notices shown to growers under a specific item on their
// submit view (e.g. "Retiring", "Increase stock", "Clear inventory"). Targeted
// at all growers (audience=All) or a selected subset (audience=Selected, via
// ItemMessageGrower). `type` is a translatable key; `body` is an optional
// free-text note shown as-authored. Optional startsAt/endsAt schedule visibility.
// ============================================================

model ItemMessage {
  id       Int       @id @default(autoincrement())
  itemId   String
  type     String // Retiring, IncreaseStock, ClearInventory, Info (translatable)
  body     String? // optional free-text note, shown as-authored
  severity String    @default("info") // info, warning, critical
  audience String    @default("All") // All, Selected
  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  item         Item                     @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targets      ItemMessageGrower[]
  translations ItemMessageTranslation[]

  @@index([itemId])
}

// Localized `body` for growers whose preferredLocale differs from the language
// the note was authored in. Written once when the message is saved (never per
// page view), so the translation API is called a handful of times a year rather
// than on every grower page load.
model ItemMessageTranslation {
  id            Int     @id @default(autoincrement())
  itemMessageId Int
  locale        String // es, ...
  body          String
  // True while the text is still raw machine output. Flipped to false as soon
  // as an admin edits it, so the list can flag what nobody has checked — these
  // notes drive real behaviour ("clear inventory"), so a bad translation costs
  // more than a missing one.
  isMachine     Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt

  message ItemMessage @relation(fields: [itemMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([itemMessageId, locale])
}

model ItemMessageGrower {
  id            Int @id @default(autoincrement())
  itemMessageId Int
  growerId      Int

  message ItemMessage @relation(fields: [itemMessageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grower  Grower      @relation(fields: [growerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([itemMessageId, growerId])
  @@index([growerId])
}
