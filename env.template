# =============================================================================
# Inventory Management & Tracking — environment variables
#
#   cp env.template .env      then edit DATABASE_URL and you can run locally.
#
# WHY THIS FILE IS NOT CALLED .env.example. .gitignore ignores `.env*`, so an
# example file with that name is invisible to git — it never appears in a diff,
# nobody reviews it, and it silently falls behind the code. This name is tracked,
# so a pull request that adds a variable and forgets to document it here is
# visible. Keep them in step: if you add a `process.env.X`, add it below.
#
# EVERY variable the application reads is listed here. Two exceptions, set by
# Next.js itself and never by you: NEXT_PHASE and NEXT_RUNTIME.
#
# Each entry is annotated:
#   LOCAL    — what to use on a developer machine
#   DEPLOYED — what to use on Azure Container Apps
# Where only one line appears, the value is the same in both.
#
# NOTE ON NEXT_PUBLIC_: nothing here needs that prefix. It inlines a value into
# the CLIENT bundle at build time, readable by anyone — so it is only for values
# that are both public AND read from a "use client" component. No client
# component here reads process.env, and everything below is a secret or a
# server-only setting. Never prefix DATABASE_URL, SESSION_SECRET, CRON_SECRET or
# any *_KEY / *_SECRET.
#
# IN AZURE, secrets come from Key Vault, not from a file. Key Vault names cannot
# contain underscores, so they are hyphenated and the pipeline maps them onto the
# names below — SESSION_SECRET is `session-secret`, and so on. See
# docs/azure-staging-setup.md §8, and set them in azure-pipelines.yml rather than
# the Portal (the pipeline is the source of truth for env vars).
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# LOCAL     sqlserver://localhost:1433;database=inventory_demo;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true
# DEPLOYED  Azure SQL, from Key Vault `database-url`. Use encrypt=true and DO NOT
#           set trustServerCertificate — Azure presents a valid certificate, and
#           trusting any certificate defeats the encryption.
DATABASE_URL="sqlserver://localhost:1433;database=inventory_demo;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"

# Scratch database Prisma uses to replay migrations (`prisma migrate dev`).
# Declared in prisma/schema.prisma, so it must exist even though `migrate deploy`
# never touches it. WIPED on every use — point it at a throwaway database, never
# at the one above.
#
# LOCAL     required if you run `prisma migrate dev`
# DEPLOYED  not set. The pipeline runs `migrate deploy`, which needs no shadow.
SHADOW_DATABASE_URL="sqlserver://localhost:1433;database=inventory_shadow;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"


# =============================================================================
# APP ORIGIN
# =============================================================================

# The absolute origin of this deployment. Three things need it and none can
# derive it from a request: emails have no page context, the scheduled reminder
# run has no request at all, and OAuth/magic-link redirects must not inherit the
# http:// scheme that Container Apps ingress presents to the container.
#
# LOCAL     http://localhost:3000
# DEPLOYED  https://<your-container-app>.<region>.azurecontainerapps.io
#           The pipeline derives this from the ingress FQDN so it cannot drift.
APP_URL=http://localhost:3000

# Fallback for APP_URL only. Present because the email templates check it, not
# because anything needs the NEXT_PUBLIC_ prefix. Set APP_URL instead; this is
# here so an existing value is not a surprise.
# NEXT_PUBLIC_APP_URL=

# LOCAL     leave unset. `next dev` sets "development" for you.
# DEPLOYED  production — baked into the image by the Dockerfile, and also set
#           explicitly on the Container App. Several safety behaviours key off
#           it: the demo user-picker refuses to render, cookies become Secure,
#           and missing secrets fail closed instead of falling back.
# NODE_ENV=production


# =============================================================================
# PROVIDER SWITCHES
# Each picks between a no-dependency local implementation and the real service.
# =============================================================================

# Entra and magic-link sign-in are always wired up. `local` ADDITIONALLY shows
# the credential-free demo user-picker on /login — and only outside production,
# so a deployed image can never expose it whatever this says.
#
# LOCAL     local     (demo picker visible)
# LOCAL     entra     (to rehearse the real login page on your machine)
# DEPLOYED  entra
AUTH_PROVIDER=local

# `local` writes mocked rows to the Outbox and sends nothing.
#
# Useful local trick: set this to `acs` but leave ACS_CONNECTION_STRING unset.
# The transport then reports success without sending, so the whole outbox path —
# pacing, priority, retries, the Outbox page — is exercisable with no Azure
# account. In production a missing connection string is a hard failure instead.
#
# LOCAL     local
# DEPLOYED  acs
EMAIL_PROVIDER=local

# `local` is a no-op: item-message notes are stored exactly as typed and growers
# fall back to the authored text. `azure` machine-translates notes on save, once
# per message rather than per page view.
#
# LOCAL     local
# DEPLOYED  azure
TRANSLATION_PROVIDER=local


# =============================================================================
# SECRETS
# All four must differ from each other. They protect different things, and a key
# that signs a session cookie must never also decrypt a Microsoft credential.
# Generate with:  openssl rand -base64 32
# =============================================================================

# Signs the session cookie, and the short-lived Entra PKCE transaction cookie.
#
# LOCAL     any long random string
# DEPLOYED  Key Vault `session-secret`. REQUIRED — the app refuses to start in
#           production without it rather than falling back to a known default.
#           Rotating it signs every user out; they simply sign in again.
SESSION_SECRET="dev-only-change-me-to-a-long-random-string"

# Signs the 15-minute passwordless sign-in links. Required for the magic-link
# flow to work at all, locally included — without it /api/auth/magic/request
# returns 500.
#
# LOCAL     any long random string, different from the others
# DEPLOYED  Key Vault `magic-link-secret`
MAGIC_LINK_SECRET="dev-only-magic-link-secret-distinct-from-the-session-one"

# Encrypts the Microsoft token cache stored against a user, which is what lets
# the Power BI reports page mint an access token later in a session rather than
# only at login. The cache holds a REFRESH token, so it never reaches the
# database in the clear.
#
# LOCAL     any long random string, or leave unset — with no value nothing is
#           stored, the reports page says so, and nothing else is affected.
# DEPLOYED  Key Vault `token-cache-secret`. Needed only for Power BI "embed for
#           your organization" (docs/azure-staging-setup.md §10d).
TOKEN_CACHE_SECRET="dev-only-token-cache-secret-distinct-from-the-others"

# Shared secret for the /api/cron/* endpoints, which the Container Apps jobs
# call. Those sit outside the session gate, so this is their whole authentication
# story — and an unset value DENIES rather than allows.
#
# LOCAL     any string (only needed if you call the cron endpoints by hand)
# DEPLOYED  Key Vault `cron-secret`. The same value must be set on BOTH jobs.
CRON_SECRET="dev-only-cron-secret"


# =============================================================================
# ITEM IMAGES (lib/storage)
# =============================================================================

# LOCAL     leave unset. Photos are written to .uploads/ in the project root, so
#           the items page works with no Azure account and no Azurite.
# DEPLOYED  Key Vault `storage-connection-string`. REQUIRED in production — an
#           unset value is a hard failure, not a fallback, because the container
#           filesystem is replaced on every revision and every photo would
#           vanish at the next deploy.
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# The blob container photos live in. Created on first use, and PRIVATE — images
# are served through /items/<id>/image, which applies the normal session gate.
AZURE_STORAGE_CONTAINER="item-images"


# =============================================================================
# EMAIL THROUGHPUT — read only when EMAIL_PROVIDER=acs
# Full explanation, and how to raise these: docs/email-delivery.md
# =============================================================================

# Your sender domain's real limits. The defaults are the conservative
# Azure-managed-domain (*.azurecomm.net) figures. A verified custom domain is
# roughly 6x both — raise these when it lands; no code change is needed.
#
# DEPLOYED  must match what the ACS resource actually allows. Confirm in the
#           portal rather than assuming.
EMAIL_RATE_PER_MINUTE=5
EMAIL_RATE_PER_HOUR=100

# Per-minute slots the bulk dispatcher will NOT spend. Sign-in links are sent
# immediately rather than queued, so without a reserve a grower requesting one
# during the morning reminder run would be throttled behind it.
EMAIL_INTERACTIVE_RESERVE=2

# Ceiling on how many messages one dispatch pass will claim.
EMAIL_DISPATCH_BATCH=25

# How often the running app drains the outbox, in ms.
#
# LOCAL     30000
# DEPLOYED  30000, or 0 to disable the in-app loop and rely solely on the
#           Container Apps job and the admin button.
EMAIL_DISPATCH_INTERVAL_MS=30000


# =============================================================================
# ENTRA ID — internal staff sign-in (lib/auth/entra.ts)
# Without these, "Sign in with Microsoft" reports that it is not configured and
# the magic-link box still works.
# =============================================================================

# LOCAL     unset, unless you are testing against a real tenant
# DEPLOYED  all four required. Setup: docs/azure-staging-setup.md §10a.
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=

# DEPLOYED  Key Vault `azure-ad-client-secret`. Expires in 6-24 months — set a
#           rotation reminder, or move to a federated credential to drop it.
# AZURE_AD_CLIENT_SECRET=

# Leave unset to derive it from APP_URL. Set it when it must match the app
# registration exactly.
#
# LOCAL     http://localhost:3000/api/auth/callback
# DEPLOYED  https://<fqdn>/api/auth/callback
# AZURE_AD_REDIRECT_URI=


# =============================================================================
# AZURE COMMUNICATION SERVICES — all outbound email
# Read only when EMAIL_PROVIDER=acs.
# =============================================================================

# DEPLOYED  Key Vault `acs-connection-string`
# ACS_CONNECTION_STRING=

# The verified sender. A *.azurecomm.net managed domain works for staging but is
# routinely spam-foldered — start custom domain verification early.
# ACS_SENDER_ADDRESS=DoNotReply@your-domain.azurecomm.net


# =============================================================================
# AZURE AI TRANSLATOR — read only when TRANSLATION_PROVIDER=azure
# =============================================================================

# DEPLOYED  Key Vault `azure-translator-key`
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=westeurope

# Leave unset to use the global endpoint.
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com


# =============================================================================
# PRODUCTION BOOTSTRAP — read only by `npm run db:bootstrap`
# Creates the reference roles and the FIRST admin on a fresh database. Not needed
# locally: prisma/seed.ts creates demo users instead.
#
# The email is a PRE-AUTHORISATION, not a credential — only the person who can
# authenticate as that Entra identity can actually use it.
# =============================================================================

# BOOTSTRAP_ADMIN_EMAIL=admin@client.com
# BOOTSTRAP_ADMIN_FIRST_NAME=Jane
# BOOTSTRAP_ADMIN_LAST_NAME=Doe
